#!/bin/bash
#PBS -N fix2_ab59_b1
#PBS -A neutrinoGPU::wirecell_2026
#PBS -q by-gpu
#PBS -l select=1:ncpus=64:ngpus=1:mem=128gb
#PBS -l walltime=00:30:00
#PBS -l filesystems=eagle:grand:home
#PBS -J 0-19
#PBS -r y
#PBS -o /lus/eagle/projects/neutrinoGPU/abhat/sbnd/single_photon/development/fix2_vertex_shower_onehop_20261005/ab59/logs/
#PBS -e /lus/eagle/projects/neutrinoGPU/abhat/sbnd/single_photon/development/fix2_vertex_shower_onehop_20261005/ab59/logs/

set -euo pipefail
echo "=== Fix2 A/B Study Batch1 ==="
echo "Array index: $PBS_ARRAY_INDEX"
echo "Node: $(hostname)  Date: $(date)"

CONTAINER=/lus/grand/projects/neutrinoGPU/software/containers/slf7.sif
LARSOFT_SQ=/lus/eagle/projects/neutrinoGPU/larsoft_hpc/images/larsoft-v10_14_02.squashfs
SBND_SQ=/lus/eagle/projects/neutrinoGPU/larsoft_hpc/images/sbnd-v10_14_02_04_delta.squashfs
DEV=/lus/eagle/projects/neutrinoGPU/abhat/sbnd/single_photon/development/fix2_vertex_shower_onehop_20261005
TEMPLATE=$DEV/ab59/jobs/run_ab59_template.sh

module use /soft/modulefiles
module load spack-pe-base
module load apptainer

apptainer exec --fakeroot \
    --bind /lus/eagle \
    --bind /lus/grand \
    --overlay "$LARSOFT_SQ":ro \
    --overlay "$SBND_SQ":ro \
    "$CONTAINER" \
    bash -lc "EVT_IDX='$PBS_ARRAY_INDEX' bash '$TEMPLATE'" \
    2>&1 | tee "$DEV/ab59/logs/container_ab59_$(printf '%04d' $PBS_ARRAY_INDEX).log"

CONTAINER_EXIT="${PIPESTATUS[0]}"
echo "Container exit: $CONTAINER_EXIT"
echo "JOB_COMPLETE_AB59_$(printf '%04d' $PBS_ARRAY_INDEX)"
date
