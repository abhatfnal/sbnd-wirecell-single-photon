#!/bin/bash
#PBS -N ncdelta_reco1_50evt
#PBS -q by-gpu
#PBS -A neutrinoGPU::wirecell_2026
#PBS -l select=1:ncpus=64:ngpus=1:mem=128gb
#PBS -l walltime=04:00:00
#PBS -l filesystems=eagle:grand:home
#PBS -e /lus/eagle/projects/neutrinoGPU/abhat/sbnd/single_photon/baseline_v0/ncdelta_50evt/logs/pbs_reco1.err
#PBS -o /lus/eagle/projects/neutrinoGPU/abhat/sbnd/single_photon/baseline_v0/ncdelta_50evt/logs/pbs_reco1.out

# baseline_v0 Phase C: Reco1 on detsim output (~50 events)
# Input:  ncdelta_50evt/detsim/ncdelta_detsim.root
# Output: ncdelta_50evt/reco1/ncdelta_reco1.root
# FCL: reco1_nosupera_sbnd.fcl (supera disabled — not needed for WireCell analysis)
set -euo pipefail

echo "=== NC Delta Reco1 (baseline_v0 50-event sample) ==="
echo "PBS_JOBID: $PBS_JOBID"
echo "Host: $(hostname)"
date

BASEDIR=/lus/eagle/projects/neutrinoGPU/abhat/sbnd/single_photon/baseline_v0/ncdelta_50evt
SRCDIR=/lus/eagle/projects/neutrinoGPU/abhat/sbnd/single_photon/signal_mc/ncdelta
INFILE="$BASEDIR/detsim/ncdelta_detsim.root"
OUTFILE="$BASEDIR/reco1/ncdelta_reco1.root"
LOGDIR="$BASEDIR/logs"
CONTAINER_LOG="$LOGDIR/container_reco1.log"

mkdir -p "$BASEDIR/reco1" "$LOGDIR"

[ -f "$INFILE" ] || { echo "FATAL: detsim file not found: $INFILE"; exit 1; }
echo "Input: $INFILE ($(du -sh $INFILE | cut -f1))"

CONTAINER=/lus/grand/projects/neutrinoGPU/software/containers/slf7.sif
LARSOFT_SQ=/lus/eagle/projects/neutrinoGPU/larsoft_hpc/images/larsoft-v10_14_02.squashfs
SBND_SQ=/lus/eagle/projects/neutrinoGPU/larsoft_hpc/images/sbnd-v10_14_02_04_delta.squashfs

module use /soft/modulefiles
module load spack-pe-base
module load apptainer

apptainer exec --fakeroot \
    --bind /lus/eagle \
    --bind /lus/grand \
    --overlay "$LARSOFT_SQ":ro \
    --overlay "$SBND_SQ":ro \
    "$CONTAINER" \
    bash -lc "$(cat <<'INNEREOF'
set -euo pipefail
BASEDIR=/lus/eagle/projects/neutrinoGPU/abhat/sbnd/single_photon/baseline_v0/ncdelta_50evt
SRCDIR=/lus/eagle/projects/neutrinoGPU/abhat/sbnd/single_photon/signal_mc/ncdelta
INFILE="$BASEDIR/detsim/ncdelta_detsim.root"
OUTFILE="$BASEDIR/reco1/ncdelta_reco1.root"
LOGDIR="$BASEDIR/logs"

gate_pass() { echo "[GATE PASS] $*"; }
gate_fail() { echo "[GATE FAIL] $*"; exit 1; }

source /lus/eagle/projects/neutrinoGPU/larsoft_hpc/envs/sbndcode-v10_14_02_04.env 2>/dev/null || true
echo "sbndcode: ${SBNDCODE_VERSION:-not set}"

# Use the same reco1_nosupera_sbnd.fcl already validated for 3-event sample
export FHICL_FILE_PATH="$SRCDIR/fcl:${FHICL_FILE_PATH:-}"
[ -f "$SRCDIR/fcl/reco1_nosupera_sbnd.fcl" ] \
    && gate_pass "reco1_nosupera_sbnd.fcl found" \
    || gate_fail "reco1_nosupera_sbnd.fcl missing"

SZ=$(stat -c%s "$OUTFILE" 2>/dev/null || echo 0)
if [ "$SZ" -gt 10000000 ]; then
    echo "[RECO1 SKIP] Output already exists ($SZ bytes)"
    gate_pass "Reco1 output present from prior run"
else
    echo "=== Run Reco1 ==="
    date
    RLOG="$LOGDIR/lar_reco1.log"
    cd "$BASEDIR/reco1"
    set +e
    lar -c reco1_nosupera_sbnd.fcl \
        -s "$INFILE" \
        -o "$OUTFILE" \
        > "$RLOG" 2>&1
    R_EXIT=$?
    set -e
    date
    SZ=$(stat -c%s "$OUTFILE" 2>/dev/null || echo 0)
    if [ $R_EXIT -ne 0 ] && [ "$SZ" -gt 10000000 ]; then
        echo "[RECO1 WARN] exit $R_EXIT but output exists ($SZ bytes) — destructor crash"
        gate_pass "Reco1 complete with destructor crash"
    elif [ $R_EXIT -ne 0 ]; then
        tail -40 "$RLOG"
        gate_fail "Reco1 failed exit=$R_EXIT"
    else
        gate_pass "Reco1 complete (exit 0)"
    fi
fi

ls -lh "$BASEDIR/reco1/"
echo "RECO1_COMPLETE"
date
INNEREOF
)" 2>&1 | tee "$CONTAINER_LOG"
CONTAINER_EXIT="${PIPESTATUS[0]}"
echo "Container exit: $CONTAINER_EXIT"
[ "$CONTAINER_EXIT" -eq 0 ] && echo "RECO1_PASS" || { tail -30 "$CONTAINER_LOG"; echo "RECO1_FAIL"; exit 1; }
