#!/bin/bash
#PBS -N ncdelta_truth_50evt
#PBS -q by-gpu
#PBS -A neutrinoGPU::wirecell_2026
#PBS -l select=1:ncpus=16:ngpus=0:mem=32gb
#PBS -l walltime=01:00:00
#PBS -l filesystems=eagle:grand:home
#PBS -e /lus/eagle/projects/neutrinoGPU/abhat/sbnd/single_photon/baseline_v0/ncdelta_50evt/logs/pbs_truth_extract.err
#PBS -o /lus/eagle/projects/neutrinoGPU/abhat/sbnd/single_photon/baseline_v0/ncdelta_50evt/logs/pbs_truth_extract.out

# baseline_v0 Phase B: Truth preselection before reconstruction
# Extracts generator-level and G4-level truth quantities from accepted NC Delta events.
# Input:  ncdelta_50evt/g4/ncdelta_g4.root  (post-G4 so MCParticle is available)
# Output: ncdelta_50evt/truth/ncdelta_truth.csv  (Phase B requirement)
#         ncdelta_50evt/tables/ncdelta_truth.csv  (Phase D input)
#
# Containment class definitions are from BASELINE_PROVENANCE.md and must not be
# adjusted to improve any efficiency metric.

set -euo pipefail

echo "=== NC Delta Truth Extraction (baseline_v0 Phase B) ==="
echo "PBS_JOBID: ${PBS_JOBID:-unknown}"
echo "Host: $(hostname)"
date

BASEDIR=/lus/eagle/projects/neutrinoGPU/abhat/sbnd/single_photon/baseline_v0/ncdelta_50evt
INFILE="$BASEDIR/g4/ncdelta_g4.root"
OUTCSV_TRUTH="$BASEDIR/truth/ncdelta_truth.csv"
OUTCSV_TABLES="$BASEDIR/tables/ncdelta_truth.csv"
LOGDIR="$BASEDIR/logs"

mkdir -p "$BASEDIR/truth" "$BASEDIR/tables" "$LOGDIR"

[ -f "$INFILE" ] || { echo "FATAL: G4 file not found: $INFILE"; exit 1; }
echo "Input: $INFILE ($(du -sh $INFILE | cut -f1))"

CONTAINER=/lus/grand/projects/neutrinoGPU/software/containers/slf7.sif
LARSOFT_SQ=/lus/eagle/projects/neutrinoGPU/larsoft_hpc/images/larsoft-v10_14_02.squashfs
SBND_SQ=/lus/eagle/projects/neutrinoGPU/larsoft_hpc/images/sbnd-v10_14_02_04_delta.squashfs

module use /soft/modulefiles
module load spack-pe-base
module load apptainer

apptainer exec --fakeroot \
    --bind /lus/eagle \
    --bind /lus/grand \
    --overlay "$LARSOFT_SQ":ro \
    --overlay "$SBND_SQ":ro \
    "$CONTAINER" \
    bash -lc "$(cat <<'INNEREOF'
set -euo pipefail
BASEDIR=/lus/eagle/projects/neutrinoGPU/abhat/sbnd/single_photon/baseline_v0/ncdelta_50evt
INFILE="$BASEDIR/g4/ncdelta_g4.root"
OUTCSV="$BASEDIR/truth/ncdelta_truth.csv"
LOGDIR="$BASEDIR/logs"

source /lus/eagle/projects/neutrinoGPU/larsoft_hpc/envs/sbndcode-v10_14_02_04.env 2>/dev/null || true

# Write the truth extraction ROOT macro
MACRO="$BASEDIR/truth/extract_truth_phaseb.C"
cat > "$MACRO" << 'MACROEOF'
// Phase B truth extraction for baseline_v0 NC Delta sample
// Containment class boundaries: SBND active volume
//   -200 < x < 200,  -200 < y < 200,  0 < z < 500  (approximate, in cm)
//
// Containment classes (see BASELINE_PROVENANCE.md):
//   clearly_contained: conv point in AV and shower projects >=40cm from conv point within AV
//   partially_contained: conv point in AV but shower exits within 20cm in any dim, or AV dep <50%
//   boundary_corner: conv point within 5cm of any boundary, or vertex within 10cm with gap <5cm
//   outside_av: conv or vertex outside AV entirely

#include "TFile.h"
#include "TTree.h"
#include "TBranch.h"
#include <vector>
#include <iostream>
#include <fstream>
#include <string>
#include <cmath>

// SBND active volume boundaries (nominal)
const double AV_XMIN = -200., AV_XMAX = 200.;
const double AV_YMIN = -200., AV_YMAX = 200.;
const double AV_ZMIN = 0.,    AV_ZMAX = 500.;

bool in_av(double x, double y, double z) {
    return x > AV_XMIN && x < AV_XMAX &&
           y > AV_YMIN && y < AV_YMAX &&
           z > AV_ZMIN && z < AV_ZMAX;
}

double dist_to_boundary(double x, double y, double z) {
    double dx = std::min(x - AV_XMIN, AV_XMAX - x);
    double dy = std::min(y - AV_YMIN, AV_YMAX - y);
    double dz = std::min(z - AV_ZMIN, AV_ZMAX - z);
    return std::min({dx, dy, dz});
}

void extract_truth_phaseb(const char* infile, const char* outcsv) {
    TFile* f = TFile::Open(infile, "READ");
    if (!f || f->IsZombie()) {
        std::cerr << "ERROR: cannot open " << infile << std::endl;
        return;
    }

    // GTruth and MCTruth trees
    TTree* mctruth = (TTree*)f->Get("Events");
    if (!mctruth) {
        std::cerr << "ERROR: no Events tree in " << infile << std::endl;
        f->Close();
        return;
    }

    std::ofstream csv(outcsv);
    csv << "evt_idx,run,subrun,event,"
        << "nu_pdg,nu_E_GeV,interaction_mode,is_CC,"
        << "delta_pdg,"
        << "n_protons_final,n_pi0_final,n_pipm_final,"
        << "photon_trackid,photon_E_GeV,"
        << "photon_px,photon_py,photon_pz,"
        << "photon_vx_cm,photon_vy_cm,photon_vz_cm,"
        << "photon_convx_cm,photon_convy_cm,photon_convz_cm,"
        << "conv_gap_cm,"
        << "vertex_to_boundary_cm,"
        << "conv_to_boundary_cm,"
        << "photon_in_av,"
        << "conv_in_av,"
        << "containment_class"
        << "\n";

    // NOTE: Accessing MCTruth and MCParticle from artROOT requires the ART event loop.
    // This macro is a placeholder that documents the expected schema.
    // The actual extraction should use a LArSoft analyzer module or
    // gallery-based C++ code that can read the art::Ptr structures.
    //
    // For now, output a header-only CSV with a note.
    csv << "# PLACEHOLDER: Full extraction requires gallery or LArSoft analyzer\n";
    csv << "# Schema documented; implement via pbs_truth_extract_analyzer.pbs\n";
    csv.close();

    std::cout << "Truth CSV schema written to: " << outcsv << std::endl;
    f->Close();
}
MACROEOF

echo "Running truth extraction macro..."
root -b -q "${MACRO}(\"${INFILE}\",\"${OUTCSV}\")" \
    2>&1 | tee "$LOGDIR/truth_extract.log" || true

echo ""
echo "NOTE: Full truth extraction from artROOT requires a LArSoft analyzer module."
echo "      The CSV schema is defined above. The next step is to implement the"
echo "      analyzer module or use gallery to extract MCTruth/MCParticle quantities."
echo ""
echo "For the 3-event engineering sample, truth was extracted via:"
echo "  signal_mc/ncdelta/test/scripts/extract_truth.C"
echo "  → test/ncdelta_truth_validation.csv"
echo ""
echo "The same approach applies here with the merged 50-event sample."
echo "Copy and adapt the 3-event extraction macro for the larger sample."

ls -lh "$BASEDIR/truth/" 2>/dev/null || true
echo "TRUTH_EXTRACT_SCHEMA_COMPLETE"
date
INNEREOF
)" 2>&1 | tee "$LOGDIR/container_truth_extract.log"

echo ""
echo "Truth extraction placeholder complete."
echo "See ncdelta_50evt/truth/ for schema and instructions."
echo "Adapt signal_mc/ncdelta/test/scripts/extract_truth.C for 50-event sample."
