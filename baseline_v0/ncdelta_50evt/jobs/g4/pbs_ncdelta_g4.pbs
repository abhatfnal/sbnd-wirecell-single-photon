#!/bin/bash
#PBS -N ncdelta_g4_50evt
#PBS -q by-gpu
#PBS -A neutrinoGPU::wirecell_2026
#PBS -l select=1:ncpus=64:ngpus=1:mem=128gb
#PBS -l walltime=04:00:00
#PBS -l filesystems=eagle:grand:home
#PBS -e /lus/eagle/projects/neutrinoGPU/abhat/sbnd/single_photon/baseline_v0/ncdelta_50evt/logs/pbs_g4.err
#PBS -o /lus/eagle/projects/neutrinoGPU/abhat/sbnd/single_photon/baseline_v0/ncdelta_50evt/logs/pbs_g4.out

# baseline_v0 Phase C: G4 on merged NC Delta gen output
# Input:  ncdelta_50evt/gen/ncdelta_gen_merged.root
# Output: ncdelta_50evt/g4/ncdelta_g4.root
# FCL: standard_g4_sbnd.fcl
set -euo pipefail

echo "=== NC Delta G4 (baseline_v0 50-event sample) ==="
echo "PBS_JOBID: $PBS_JOBID"
echo "Host: $(hostname)"
date

BASEDIR=/lus/eagle/projects/neutrinoGPU/abhat/sbnd/single_photon/baseline_v0/ncdelta_50evt
INFILE="$BASEDIR/gen/ncdelta_gen_merged.root"
OUTFILE="$BASEDIR/g4/ncdelta_g4.root"
LOGDIR="$BASEDIR/logs"
CONTAINER_LOG="$LOGDIR/container_g4.log"

mkdir -p "$BASEDIR/g4" "$LOGDIR"

[ -f "$INFILE" ] || { echo "FATAL: merged gen file not found: $INFILE"; exit 1; }
echo "Input: $INFILE ($(du -sh $INFILE | cut -f1))"

CONTAINER=/lus/grand/projects/neutrinoGPU/software/containers/slf7.sif
LARSOFT_SQ=/lus/eagle/projects/neutrinoGPU/larsoft_hpc/images/larsoft-v10_14_02.squashfs
SBND_SQ=/lus/eagle/projects/neutrinoGPU/larsoft_hpc/images/sbnd-v10_14_02_04_delta.squashfs

module use /soft/modulefiles
module load spack-pe-base
module load apptainer

apptainer exec --fakeroot \
    --bind /lus/eagle \
    --bind /lus/grand \
    --overlay "$LARSOFT_SQ":ro \
    --overlay "$SBND_SQ":ro \
    "$CONTAINER" \
    bash -lc "$(cat <<'INNEREOF'
set -euo pipefail
BASEDIR=/lus/eagle/projects/neutrinoGPU/abhat/sbnd/single_photon/baseline_v0/ncdelta_50evt
INFILE="$BASEDIR/gen/ncdelta_gen_merged.root"
OUTFILE="$BASEDIR/g4/ncdelta_g4.root"
LOGDIR="$BASEDIR/logs"

gate_pass() { echo "[GATE PASS] $*"; }
gate_fail() { echo "[GATE FAIL] $*"; exit 1; }

source /lus/eagle/projects/neutrinoGPU/larsoft_hpc/envs/sbndcode-v10_14_02_04.env 2>/dev/null || true
echo "sbndcode: ${SBNDCODE_VERSION:-not set}"

SZ=$(stat -c%s "$OUTFILE" 2>/dev/null || echo 0)
if [ "$SZ" -gt 10000000 ]; then
    echo "[G4 SKIP] Output already exists ($SZ bytes)"
    gate_pass "G4 output present from prior run"
else
    echo "=== Run G4 ==="
    date
    G4LOG="$LOGDIR/lar_g4.log"
    cd "$BASEDIR/g4"
    set +e
    lar -c standard_g4_sbnd.fcl \
        -s "$INFILE" \
        -o "$OUTFILE" \
        > "$G4LOG" 2>&1
    G4_EXIT=$?
    set -e
    date
    SZ=$(stat -c%s "$OUTFILE" 2>/dev/null || echo 0)
    if [ $G4_EXIT -ne 0 ] && [ "$SZ" -gt 10000000 ]; then
        echo "[G4 WARN] exit $G4_EXIT but output exists ($SZ bytes) — likely destructor crash"
        gate_pass "G4 complete with destructor crash (valid output)"
    elif [ $G4_EXIT -ne 0 ]; then
        tail -40 "$G4LOG"
        gate_fail "G4 failed exit=$G4_EXIT"
    else
        gate_pass "G4 complete (exit 0)"
    fi
fi

ls -lh "$BASEDIR/g4/"
echo "G4_COMPLETE"
date
INNEREOF
)" 2>&1 | tee "$CONTAINER_LOG"
CONTAINER_EXIT="${PIPESTATUS[0]}"
echo "Container exit: $CONTAINER_EXIT"
[ "$CONTAINER_EXIT" -eq 0 ] && echo "G4_PASS" || { tail -30 "$CONTAINER_LOG"; echo "G4_FAIL"; exit 1; }
