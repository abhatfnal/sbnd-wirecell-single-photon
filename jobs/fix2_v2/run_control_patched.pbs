#!/bin/bash
#PBS -N fix2_run
#PBS -A neutrinoGPU::wirecell_2026
#PBS -q by-gpu
#PBS -l select=1:ncpus=64:ngpus=1:mem=128gb
#PBS -l walltime=00:30:00
#PBS -l filesystems=eagle:grand:home
#PBS -o /lus/eagle/projects/neutrinoGPU/abhat/sbnd/single_photon/development/fix2_vertex_shower_onehop_20261005/logs/run_control_patched.out
#PBS -e /lus/eagle/projects/neutrinoGPU/abhat/sbnd/single_photon/development/fix2_vertex_shower_onehop_20261005/logs/run_control_patched.err

# Steps 6+7: control run (unpatched) and patched run for evt_0058
# Verifies: control shw_sp_filled=0; patched shw_sp_filled=1, shw_sp_n_20mev_showers>=1
set -euo pipefail

echo "=== Fix2 Control+Patched Run ==="
echo "Node: $(hostname)"
echo "Date: $(date)"

CONTAINER=/lus/grand/projects/neutrinoGPU/software/containers/slf7.sif
LARSOFT_SQ=/lus/eagle/projects/neutrinoGPU/larsoft_hpc/images/larsoft-v10_14_02.squashfs
SBND_SQ=/lus/eagle/projects/neutrinoGPU/larsoft_hpc/images/sbnd-v10_14_02_04_delta.squashfs

DEV=/lus/eagle/projects/neutrinoGPU/abhat/sbnd/single_photon/development/fix2_vertex_shower_onehop_20261005
CAND=/lus/eagle/projects/neutrinoGPU/abhat/sbnd/sample_generation_port/work/latest_wct_master_migration_candidate_20260930
INTDIR=/lus/eagle/projects/neutrinoGPU/abhat/sbnd/sample_generation_port/work/haiwang-current/integration-2026-09-08
CFGDIR=$INTDIR/reco-bundle-id-fix-validation-20260916/config-final
SNAPSHOT=/lus/eagle/projects/neutrinoGPU/abhat/sbnd/single_photon/runtime/wire-cell-data

# Input: 50-event ncdelta reco1 — evt_0058 is index 58 (0-based)
INFILE=/lus/eagle/projects/neutrinoGPU/abhat/sbnd/single_photon/baseline_v0/ncdelta_50evt/reco1/ncdelta_reco1.root
EVT_IDX=58

module use /soft/modulefiles
module load spack-pe-base
module load apptainer

run_inner() {
    local MODE="$1"   # "control" or "patched"
    local OUTDIR="$DEV/$MODE/evt_0058"
    local LOGFILE="$DEV/logs/lar_fix2_${MODE}_evt0058.log"

    echo ""
    echo "=== $MODE run (evt_idx=$EVT_IDX) ==="
    date

    apptainer exec --fakeroot \
        --bind /lus/eagle \
        --bind /lus/grand \
        --overlay "$LARSOFT_SQ":ro \
        --overlay "$SBND_SQ":ro \
        "$CONTAINER" \
        bash -lc "
set -euo pipefail
MODE='$MODE'
OUTDIR='$OUTDIR'
LOGFILE='$LOGFILE'
DEV='$DEV'
CAND='$CAND'
CFGDIR='$CFGDIR'
SNAPSHOT='$SNAPSHOT'
INFILE='$INFILE'
EVT_IDX='$EVT_IDX'

source /lus/eagle/projects/neutrinoGPU/larsoft_hpc/envs/sbndcode-v10_14_02_04.env 2>/dev/null || true

CAND_WCTLIB=\$CAND/install/wct-clean/lib
CAND_LWCLIB=\$CAND/build/lwc-install-clean/lib

if [ \"\$MODE\" = 'patched' ]; then
    # Prepend dev library so it shadows production libWireCellClus.so
    export LD_LIBRARY_PATH=\"\$DEV/build:\$CAND_LWCLIB:\$CAND_WCTLIB:\${LD_LIBRARY_PATH:-}\"
    echo '[PATCHED] libWireCellClus.so from \$DEV/build prepended'
else
    export LD_LIBRARY_PATH=\"\$CAND_LWCLIB:\$CAND_WCTLIB:\${LD_LIBRARY_PATH:-}\"
    echo '[CONTROL] using production libWireCellClus.so'
fi
export CET_PLUGIN_PATH=\"\$CAND_LWCLIB:\$CAND_WCTLIB:\${CET_PLUGIN_PATH:-}\"
export WIRECELL_PATH=\"\${SNAPSHOT}:\${CFGDIR}:\${CAND}/config/sce-override:\${CAND}/wct/cfg\"
export FHICL_FILE_PATH=\"\$CAND/config:\$CFGDIR:\${FHICL_FILE_PATH:-}\"

# Verify correct library will be loaded
echo 'libWireCellClus.so that will be loaded:'
ldconfig -p 2>/dev/null | grep WireCellClus || true
ls -lh \"\$(echo \$LD_LIBRARY_PATH | tr ':' '\n' | while read d; do f=\"\$d/libWireCellClus.so\"; [ -f \"\$f\" ] && echo \"\$f\" && break; done)\" 2>/dev/null || true

cd \"\$OUTDIR\"
set +e
lar --nskip \$EVT_IDX -n 1 \
    -c wcls-img-clus-matching-xin-prod.fcl \
    -s \"\$INFILE\" \
    --no-output \
    > \"\$LOGFILE\" 2>&1
LAR_EXIT=\$?
set -e
echo \"lar exit: \$LAR_EXIT\"

# Summarize key outputs
echo 'Output files:'
ls -lh \"\$OUTDIR/\" 2>/dev/null || true

# Quick check of T_tagger shw_sp fields from tracking-pr.root
if [ -f \"\$OUTDIR/tracking-pr.root\" ]; then
    python3 - <<'PYEOF'
import sys
try:
    import ROOT
    ROOT.gROOT.SetBatch(True)
    f = ROOT.TFile('/lus/eagle/projects/neutrinoGPU/abhat/sbnd/single_photon/development/fix2_vertex_shower_onehop_20261005/' + '${MODE}' + '/evt_0058/tracking-pr.root')
    t = f.Get('T_tagger')
    if not t or t.GetEntries() == 0:
        print('T_tagger empty or missing')
        sys.exit(0)
    t.GetEntry(0)
    filled = getattr(t, 'shw_sp_filled', -1)
    n20 = getattr(t, 'shw_sp_n_20mev_showers', -1)
    energy = getattr(t, 'shw_sp_energy', -1)
    print(f'shw_sp_filled={filled} shw_sp_n_20mev_showers={n20} shw_sp_energy={energy:.1f}MeV')
except Exception as e:
    print(f'ROOT check failed: {e}')
PYEOF
else
    echo 'tracking-pr.root not found'
fi

if [ \$LAR_EXIT -ne 0 ]; then
    echo \"[WARN] lar exited \$LAR_EXIT\"
    tail -30 \"\$LOGFILE\"
fi
echo \"${MODE^^}_RUN_DONE\"
" 2>&1 | tee "$DEV/logs/container_fix2_${MODE}_evt0058.log"
    echo "Container exit: ${PIPESTATUS[0]}"
}

# Step 6: Control run (unpatched)
run_inner "control"

# Step 7: Patched run
run_inner "patched"

echo ""
echo "=== BOTH_RUNS_COMPLETE ==="
date
