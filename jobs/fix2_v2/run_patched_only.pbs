#!/bin/bash
#PBS -N fix2_patch
#PBS -A neutrinoGPU::wirecell_2026
#PBS -q by-gpu
#PBS -l select=1:ncpus=64:ngpus=1:mem=128gb
#PBS -l walltime=00:20:00
#PBS -l filesystems=eagle:grand:home
#PBS -o /lus/eagle/projects/neutrinoGPU/abhat/sbnd/single_photon/development/fix2_vertex_shower_onehop_20261005/logs/run_patched_only.out
#PBS -e /lus/eagle/projects/neutrinoGPU/abhat/sbnd/single_photon/development/fix2_vertex_shower_onehop_20261005/logs/run_patched_only.err

# Step 7: Patched run for evt_0058 with rebuilt libWireCellClus.so (Fix 2)
set -euo pipefail

echo "=== Fix2 Patched Run evt_0058 ==="
echo "Node: $(hostname)"
echo "Date: $(date)"

CONTAINER=/lus/grand/projects/neutrinoGPU/software/containers/slf7.sif
LARSOFT_SQ=/lus/eagle/projects/neutrinoGPU/larsoft_hpc/images/larsoft-v10_14_02.squashfs
SBND_SQ=/lus/eagle/projects/neutrinoGPU/larsoft_hpc/images/sbnd-v10_14_02_04_delta.squashfs

DEV=/lus/eagle/projects/neutrinoGPU/abhat/sbnd/single_photon/development/fix2_vertex_shower_onehop_20261005
CAND=/lus/eagle/projects/neutrinoGPU/abhat/sbnd/sample_generation_port/work/latest_wct_master_migration_candidate_20260930
INTDIR=/lus/eagle/projects/neutrinoGPU/abhat/sbnd/sample_generation_port/work/haiwang-current/integration-2026-09-08
CFGDIR=$INTDIR/reco-bundle-id-fix-validation-20260916/config-final
SNAPSHOT=/lus/eagle/projects/neutrinoGPU/abhat/sbnd/single_photon/runtime/wire-cell-data

INFILE=/lus/eagle/projects/neutrinoGPU/abhat/sbnd/single_photon/baseline_v0/ncdelta_50evt/reco1/ncdelta_reco1.root
EVT_IDX=58

module use /soft/modulefiles
module load spack-pe-base
module load apptainer

apptainer exec --fakeroot \
    --bind /lus/eagle \
    --bind /lus/grand \
    --overlay "$LARSOFT_SQ":ro \
    --overlay "$SBND_SQ":ro \
    "$CONTAINER" \
    bash -lc "
set -euo pipefail
DEV='$DEV'
CAND='$CAND'
CFGDIR='$CFGDIR'
SNAPSHOT='$SNAPSHOT'
INFILE='$INFILE'
EVT_IDX='$EVT_IDX'
OUTDIR='$DEV/patched/evt_0058'
LOGFILE='$DEV/logs/lar_fix2_patched_evt0058.log'

source /lus/eagle/projects/neutrinoGPU/larsoft_hpc/envs/sbndcode-v10_14_02_04.env 2>/dev/null || true

CAND_WCTLIB=\$CAND/install/wct-clean/lib
CAND_LWCLIB=\$CAND/build/lwc-install-clean/lib

# Prepend dev library so it shadows production libWireCellClus.so
export LD_LIBRARY_PATH=\"\$DEV/build:\$CAND_LWCLIB:\$CAND_WCTLIB:\${LD_LIBRARY_PATH:-}\"
export CET_PLUGIN_PATH=\"\$CAND_LWCLIB:\$CAND_WCTLIB:\${CET_PLUGIN_PATH:-}\"
export WIRECELL_PATH=\"\${SNAPSHOT}:\${CFGDIR}:\${CAND}/config/sce-override:\${CAND}/wct/cfg\"
export FHICL_FILE_PATH=\"\$CAND/config:\$CFGDIR:\${FHICL_FILE_PATH:-}\"

echo '[PATCHED] LD_LIBRARY_PATH first entry:'
echo \$LD_LIBRARY_PATH | tr ':' '\n' | head -1

# Confirm which libWireCellClus.so will be loaded
echo 'Library that will be loaded:'
IFS=':' read -ra DIRS <<< \"\$LD_LIBRARY_PATH\"
for d in \"\${DIRS[@]}\"; do
    if [ -f \"\$d/libWireCellClus.so\" ]; then
        ls -lh \"\$d/libWireCellClus.so\"
        break
    fi
done

cd \"\$OUTDIR\"
set +e
lar --nskip \$EVT_IDX -n 1 \
    -c wcls-img-clus-matching-xin-prod.fcl \
    -s \"\$INFILE\" \
    --no-output \
    > \"\$LOGFILE\" 2>&1
LAR_EXIT=\$?
set -e
echo \"lar exit: \$LAR_EXIT\"

echo 'Output files in patched/evt_0058:'
ls -lh \"\$OUTDIR/\" 2>/dev/null

# Extract shw_sp values from tracking-pr.root
if [ -f \"\$OUTDIR/tracking-pr.root\" ]; then
    python3 - <<'PYEOF'
import sys
try:
    import ROOT
    ROOT.gROOT.SetBatch(True)
    f = ROOT.TFile('/lus/eagle/projects/neutrinoGPU/abhat/sbnd/single_photon/development/fix2_vertex_shower_onehop_20261005/patched/evt_0058/tracking-pr.root')
    t = f.Get('T_tagger')
    if not t or t.GetEntries() == 0:
        print('T_tagger: empty or missing')
        sys.exit(0)
    t.GetEntry(0)
    filled = getattr(t, 'shw_sp_filled', -1)
    n20 = getattr(t, 'shw_sp_n_20mev_showers', -1)
    energy = getattr(t, 'shw_sp_energy', -1)
    n20br1 = getattr(t, 'shw_sp_n_20br1_showers', -1)
    print(f'RESULT: shw_sp_filled={filled} shw_sp_n_20mev_showers={n20} shw_sp_energy={energy:.1f}MeV shw_sp_n_20br1_showers={n20br1}')
except Exception as e:
    print(f'ROOT_CHECK_ERROR: {e}')
PYEOF
else
    echo 'tracking-pr.root: NOT FOUND'
fi

if [ \$LAR_EXIT -ne 0 ]; then
    echo '[WARN] lar exited non-zero; checking lar log for dlopen errors:'
    grep -i 'failed to load\|undefined symbol\|WireCellClus\|dlopen' \"\$LOGFILE\" | head -5 || true
    tail -20 \"\$LOGFILE\"
fi
echo 'PATCHED_RUN_DONE'
" 2>&1 | tee "$DEV/logs/container_fix2_patched_evt0058.log"
CONTAINER_EXIT="${PIPESTATUS[0]}"

echo ""
echo "Container exit: $CONTAINER_EXIT"
echo "PATCHED_JOB_COMPLETE"
date
